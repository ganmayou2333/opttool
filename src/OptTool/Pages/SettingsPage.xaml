<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OptTool.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OptTool.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                <TextBlock Style="{StaticResource CardLabelStyle}"
                           Text="数据目录、便携模式、提权状态、备份上限与关于" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="读取状态" Message="正在读取设置信息…" />

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Visible" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 存储与便携模式 -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="存储与便携模式" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="13" Text="exe 目录可写：" />
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Visibility="{x:Bind ViewModel.ExeDirWritable, Mode=OneWay}">
                                <TextBlock FontSize="11" Text="可写" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Visibility="{x:Bind ViewModel.ExeDirNotWritable, Mode=OneWay}">
                                <TextBlock FontSize="11" Text="不可写" />
                            </Border>
                        </StackPanel>

                        <TextBlock FontSize="13"
                                   Text="{x:Bind ViewModel.PortableModeText, Mode=OneWay}"
                                   TextWrapping="Wrap" />

                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="程序目录（AppContext.BaseDirectory）：" />
                        <TextBlock FontSize="12"
                                   FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.BaseDir, Mode=OneWay}"
                                   TextWrapping="Wrap" />

                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="数据目录：" />
                        <TextBlock FontSize="12"
                                   FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.DataDir, Mode=OneWay}"
                                   TextWrapping="Wrap" />

                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.DataDirSizeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 权限 -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="权限" />
                        <TextBlock FontSize="13"
                                   Text="{x:Bind ViewModel.ElevationText, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 备份 -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="备份体积上限" />
                        <TextBlock FontSize="13"
                                   Text="{x:Bind ViewModel.BackupLimitText, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="关于 OptTool" />
                        <TextBlock FontSize="13"
                                   Text="一个只读体检优先的 Windows 系统优化工具。所有修改类操作遵循「检测 → 备份 → 执行 → 复验 → 可回滚」闭环。"
                                   TextWrapping="Wrap" />

                        <TextBlock FontWeight="SemiBold" Text="风险声明" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RiskStatements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                                        <TextBlock FontSize="13" Text="{x:Bind}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
