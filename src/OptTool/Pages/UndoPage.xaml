<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OptTool.Pages.UndoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OptTool.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="撤销中心" />
                <TextBlock Style="{StaticResource CardLabelStyle}"
                           Text="列出全部历史操作；第一版只展示，不执行回滚" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="读取状态" Message="正在读取操作历史…" />

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Visible" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 空状态 -->
                <Border Style="{StaticResource StatCardStyle}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <FontIcon FontSize="28" Glyph="&#xE7C8;" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="暂无操作历史" />
                        <TextBlock FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="还没有执行过任何修改操作。可先到「体检仪表盘」做一次只读体检；后续版本执行优化后，所有改动都会记录在这里并支持逐条撤销。" />
                    </StackPanel>
                </Border>

                <!-- 历史记录 -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Records}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRowViewModel">
                            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind OperationName}" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock FontSize="11" Text="{x:Bind RiskLevel}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind TimeText}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind ChangeCountText}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="撤销此操作"
                                            Click="RollbackButton_Click">
                                        <TextBlock Text="撤销此操作" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
