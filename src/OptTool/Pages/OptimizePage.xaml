<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OptTool.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OptTool.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="优化调整" />
                <TextBlock Style="{StaticResource CardLabelStyle}"
                           Text="列出真实开机启动项，受 GuardList 保护的项不可修改；第一版不执行改动" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="读取状态" Message="正在读取启动项…" />

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Visible" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="启动项汇总" />
                        <TextBlock FontSize="13"
                                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupItemViewModel">
                            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Visibility="{x:Bind IsProtected, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="受保护" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12"
                                                   FontFamily="Consolas"
                                                   Text="{x:Bind Command}"
                                           TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Source}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind StatusText}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="修改启动项"
                                            Click="ModifyButton_Click"
                                            Tag="{x:Bind Name}">
                                        <TextBlock Text="修改" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
